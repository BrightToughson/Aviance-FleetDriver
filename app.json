{
  "expo": {
    "name": "Aviance-FleetDriver",
    "slug": "Aviance-FleetDriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/logo.png",
    "scheme": "aviancefleetdriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon/favicon.PNG"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Aviance Fleet to access your camera to scan vehicle codes for inspections, fuel logs, and reports."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Aviance Fleet to access your photos to upload receipts.",
          "cameraPermission": "Allow Aviance Fleet to access your camera to capture receipts."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
